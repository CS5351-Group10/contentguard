{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "contentguard-requirements-schema-v1",
  "title": "ContentGuard requirements registry schema (D1, CI gate 3)",
  "description": "Validates docs/req/requirements.yaml. Every requirement: ID, type, statement, machine-checkable fit criterion, MoSCoW priority. Invariants additionally require an enforcing component, a verification method, a concrete operational fallback, and zero-tolerance marking.",
  "type": "object",
  "required": ["project", "version", "requirements"],
  "additionalProperties": false,
  "properties": {
    "project": { "type": "string", "const": "ContentGuard" },
    "version": { "type": "string", "pattern": "^\\d+\\.\\d+$" },
    "moscow_tradeoff_note": {
      "type": "string",
      "minLength": 20,
      "description": "The explicit MoSCoW tradeoff statement required by the spec (D1)."
    },
    "requirements": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/requirement" }
    }
  },
  "$defs": {
    "requirement": {
      "type": "object",
      "required": ["id", "type", "statement", "fit_criterion", "priority", "status", "verification", "source"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "pattern": "^REQ-(FUN|INV|QUA|PER|COS|GOV|SEC)-\\d{3}$" },
        "type": {
          "type": "string",
          "enum": ["functional", "invariant", "quality", "performance", "cost", "governance", "security"]
        },
        "title": { "type": "string", "minLength": 3 },
        "statement": { "type": "string", "minLength": 15 },
        "fit_criterion": {
          "type": "string",
          "minLength": 15,
          "description": "Machine-checkable pass/fail criterion (metric + threshold + verification for non-functional)."
        },
        "priority": { "type": "string", "enum": ["must", "should", "could", "wont"] },
        "status": { "type": "string", "enum": ["draft", "agreed", "baselined", "implemented", "verified"] },
        "changed_date": { "type": "string", "format": "date" },
        "verification": {
          "type": "object",
          "required": ["method"],
          "additionalProperties": false,
          "properties": {
            "method": {
              "type": "string",
              "enum": ["unit-test", "integration-test", "structural-check", "live-test", "ci-gate", "manual-review"]
            },
            "evidence": { "type": "string", "description": "Test file path / CI gate / review memo reference." }
          }
        },
        "source": {
          "type": "object",
          "required": ["origin"],
          "additionalProperties": false,
          "properties": {
            "origin": { "type": "string", "minLength": 3 },
            "links": { "type": "array", "items": { "type": "string" } }
          }
        },
        "enforcing_component": {
          "type": "string",
          "description": "Component that enforces this requirement (mandatory for invariants)."
        },
        "fallback": {
          "type": "string",
          "minLength": 20,
          "description": "Concrete operational action taken if violated — must be an action, not 'fix the bug' (mandatory for invariants)."
        },
        "zero_tolerance": {
          "type": "boolean",
          "description": "True for invariants: non-negotiable rules with zero-tolerance fit criteria."
        }
      },
      "allOf": [
        {
          "if": { "properties": { "type": { "const": "invariant" } }, "required": ["type"] },
          "then": {
            "required": ["enforcing_component", "fallback", "zero_tolerance"],
            "properties": { "zero_tolerance": { "const": true } }
          }
        },
        {
          "if": { "properties": { "type": { "enum": ["quality", "performance", "cost"] } }, "required": ["type"] },
          "then": {
            "properties": {
              "fit_criterion": { "type": "string", "minLength": 25 }
            }
          }
        }
      ]
    }
  }
}
