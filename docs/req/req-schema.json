{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "contentguard-requirements-schema-v2",
  "title": "ContentGuard requirements registry schema (D1, v2)",
  "description": "Requirements registry v1.0: per-requirement lifecycle status, source provenance, MoSCoW rationale, separately maintained architecture/test traceability, and optional provisional flags for pending ratification.",
  "type": "object",
  "required": [
    "project",
    "version",
    "requirements",
    "moscow_tradeoff_note"
  ],
  "additionalProperties": false,
  "properties": {
    "project": {
      "type": "string",
      "const": "ContentGuard"
    },
    "version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+$"
    },
    "requirements": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/requirement"
      }
    },
    "moscow_tradeoff_note": {
      "type": "string",
      "minLength": 40,
      "description": "Explicit MoSCoW MVP scope and deferrals, revisited at each requirements baseline change."
    }
  },
  "$defs": {
    "requirement": {
      "type": "object",
      "required": [
        "id",
        "type",
        "statement",
        "fit_criterion",
        "priority",
        "verification",
        "status",
        "source"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^REQ-(FUN|INV|QUA|PER|COS|GOV|SEC)-\\d{3}$"
        },
        "type": {
          "type": "string",
          "enum": [
            "functional",
            "invariant",
            "quality",
            "performance",
            "cost",
            "governance",
            "security"
          ]
        },
        "title": {
          "type": "string",
          "minLength": 3
        },
        "statement": {
          "type": "string",
          "minLength": 15
        },
        "fit_criterion": {
          "type": "string",
          "minLength": 15,
          "description": "Machine-checkable pass/fail criterion (metric + threshold + verification for non-functional)."
        },
        "priority": {
          "type": "string",
          "enum": [
            "must",
            "should",
            "could",
            "wont"
          ]
        },
        "changed_date": {
          "type": "string",
          "format": "date"
        },
        "verification": {
          "type": "object",
          "required": [
            "method"
          ],
          "additionalProperties": false,
          "properties": {
            "method": {
              "type": "string",
              "enum": [
                "unit-test",
                "integration-test",
                "structural-check",
                "live-test",
                "ci-gate",
                "manual-review"
              ]
            },
            "evidence": {
              "type": "string",
              "description": "Test file path / CI gate / review memo reference."
            }
          }
        },
        "enforcing_component": {
          "type": "string",
          "description": "Component that enforces this requirement (mandatory for invariants)."
        },
        "fallback": {
          "type": "string",
          "minLength": 20,
          "description": "Concrete operational action taken if violated (mandatory for invariants) — must be an action, not 'fix the bug'."
        },
        "zero_tolerance": {
          "type": "boolean",
          "description": "True for invariants: non-negotiable rules with zero-tolerance fit criteria."
        },
        "status": {
          "type": "string",
          "enum": [
            "draft",
            "agreed",
            "baselined",
            "implemented",
            "verified"
          ],
          "description": "Requirement lifecycle state; independent of MoSCoW priority."
        },
        "source": {
          "type": "object",
          "required": [
            "origin"
          ],
          "additionalProperties": false,
          "properties": {
            "origin": {
              "type": "string",
              "minLength": 3
            },
            "links": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "uniqueItems": true
            }
          }
        },
        "provisional": {
          "type": "boolean",
          "description": "True indicates a proposed numerical fit criterion or interface/fallback contract awaiting explicit Testing Lead/PM (and relevant ADR) ratification; it is not evidence of approval."
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "type": {
                "const": "invariant"
              }
            },
            "required": [
              "type"
            ]
          },
          "then": {
            "required": [
              "enforcing_component",
              "fallback",
              "zero_tolerance"
            ],
            "properties": {
              "zero_tolerance": {
                "const": true
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "enum": [
                  "quality",
                  "performance",
                  "cost"
                ]
              }
            },
            "required": [
              "type"
            ]
          },
          "then": {
            "properties": {
              "fit_criterion": {
                "type": "string",
                "minLength": 25
              }
            }
          }
        }
      ]
    }
  }
}
